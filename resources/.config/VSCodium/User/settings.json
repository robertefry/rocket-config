{
    "window.titleBarStyle": "custom",
    "window.commandCenter": false,
    "window.zoomLevel": 0.33,

    "workbench.layoutControl.enabled": false,
    "workbench.secondarySideBar.defaultVisibility": "hidden",

    "explorer.sortOrder": "default",
    "explorer.sortOrderLexicographicOptions": "unicode",

    "editor.fontSize": 15,
    "editor.fontFamily": "'Fira Code'",
    "editor.fontLigatures": true,
    "editor.bracketPairColorization.enabled": false,

    "editor.rulers": [80,100,120,128],
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 120,
    "editor.wordWrapIndicator": true,
    "editor.wrappingStrategy": "simple",

    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,

    "editor.inlineSuggest.suppressSuggestions": true,
    "editor.quickSuggestions": "off",

    "git.confirmSync": true,
    "git.suggestSmartCommit": false,

    "chat.disableAIFeatures": true,

    // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ //
    //  Colour Customizations
    // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ //

    "workbench.colorTheme": "FlatUI Dark",

    "editor.tokenColorCustomizations": {
        "comments": "#FF3D00", // Material Deep Orange A400
        "textMateRules": [{
            "scope": [
                "comment.block.documentation",
                "comment.block.documentation punctuation.definition.comment",
                "comment.block.javadoc",
                "comment.block.javadoc punctuation.definition.comment"
            ],
            // "settings": { "foreground": "#43A047" } // Material Green 600
            "settings": { "foreground": "#757575" } // Material Grey 600
        }]
    },

    // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ //
    //  Language Settings
    // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ //

    "[tex][latex][bibtex]": {
        "editor.wordWrap": "on",
    },

    "zig.zls.inlayHintsExcludeSingleArgument": false,
    "zig.zls.inlayHintsShowBuiltin": false,
    "zig.zls.inlayHintsShowParameterName": false,
    "zig.zls.inlayHintsShowStructLiteralFieldType": false,
    "zig.zls.inlayHintsShowVariableTypeHints": false,

    // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ //
    //  Plugin Settings
    // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ //

    // "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg",

    // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ //
    //  Spell-Check Dictionary
    // ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ //

    "cSpell.enabled": true,
    "cSpell.language": "en-GB,en-US",
    "cSpell.userWords": [
    ],

}
